# ========================================
# Frontend Variables (Public)
# ========================================
# Importante: Como estas variables empiezan con VITE_, serán inyectadas
# en el código fuente de Javascript visible por el navegador (Build-time).

# URL Pública de la API (Sin slash / al final).
# Ejemplo Desarrollo: http://localhost:3000
# Ejemplo Prod: https://api.tudominio.com
VITE_API_URL=

# URL pública del microservicio de almacenamiento (bucketService), usada para
# visualizar imágenes/archivos (sin slash / al final). No incluye la API key.
# Ejemplo: https://cosmo.mineduc.edu.gt/api/v1/storage
VITE_STORAGE_URL=
